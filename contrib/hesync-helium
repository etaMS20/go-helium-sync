#!/bin/sh
# Starts Helium, syncing bookmarks before it opens and after it closes.
# Expects Helium at /usr/bin/helium (native package). Needs adjustments for AppImage/Flatpak.
lock="${XDG_CONFIG_HOME:-$HOME/.config}/net.imput.helium/SingletonLock"

# Helium already running: just hand over to it, the first launch syncs on close
[ -L "$lock" ] && exec /usr/bin/helium "$@"

hesync sync || notify-send hesync "sync before start failed"
/usr/bin/helium "$@"
hesync sync || notify-send hesync "sync after close failed"
